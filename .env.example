# 复制为 .env 并填写。.env 已在 .gitignore 中，不要提交。

# Archive 节点（必须是 archive —— T0 的部署区块二分查找要查历史 eth_getCode）
ALCHEMY_API_KEY=

# Etherscan V2：单 key + chainid 参数覆盖多链。仅 P2 的 T9/T10 需要
ETHERSCAN_API_KEY=

# 扫描者身份 —— 两项都是必填。缺失时程序必须拒绝启动，不许匿名扫描。
# 它们会拼进 User-Agent，是探测伦理红线的一部分（CLAUDE.md 硬约束 13）。
SCANNER_CONTACT_EMAIL=
SCANNER_REPO_URL=

# 本地 Kubo 节点网关。这一项直接决定 T3 是 3 小时还是 30 小时。
IPFS_GATEWAY_LOCAL=http://127.0.0.1:8080
